# Copiar a .env.local para desarrollo. En Vercel se cargan en Settings > Environment Variables.
# Las VITE_ viajan al navegador (son públicas); el resto sólo existe en las funciones de api/.

# URL del proyecto de Supabase (Settings > API). La usan la app y las funciones de api/.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Clave pública (anon) de Supabase. Es pública a propósito: lo que protege los datos es RLS.
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY
# Clave pública VAPID para suscribir el navegador a las notificaciones push.
VITE_VAPID_PUBLIC_KEY=TU_VAPID_PUBLIC_KEY
# Clave privada VAPID, par de la anterior. Sólo servidor (api/_notificaciones/enviar.ts).
VAPID_PRIVATE_KEY=TU_VAPID_PRIVATE_KEY
# Contacto VAPID que se manda con cada push, por ejemplo mailto:hola@tu-dominio.
VAPID_SUBJECT=mailto:TU_MAIL
# Service role de Supabase: saltea RLS. Sólo servidor (cron de avisos y api/dolar.ts desde la 0039). Nunca con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
# Secreto que Vercel Cron manda en Authorization para que nadie más dispare api/notificaciones.ts.
CRON_SECRET=UN_TEXTO_LARGO_AL_AZAR
# Clave de la API de Anthropic para las recomendaciones de la IA (api/recomendaciones.ts).
ANTHROPIC_API_KEY=TU_ANTHROPIC_API_KEY
